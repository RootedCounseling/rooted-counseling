---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" description="Your message is on its way to Matthew.">
  <section class="section">
    <div class="wrap">
      <h1>Your message is on its way.</h1>
      <p class="lede">
        Reaching out is often the hardest step — you've just taken it.
      </p>
      <p>
        Matthew will read your message himself and reply personally, usually within one business day. In the
        meantime, there's nothing you need to do.
      </p>
      <p><a href="/">Back to the homepage</a></p>
    </div>
  </section>
</Base>
